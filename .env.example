APP_NAME=Social Feed & Media Metadata Microservice
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["*"]

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/social_feed_db
DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300

UPLOAD_URL_EXPIRY_SECONDS=300
UPLOAD_BASE_URL=http://localhost:8000/uploads

MAX_CAPTION_LENGTH=2200
DEFAULT_PAGE_LIMIT=10
MAX_PAGE_LIMIT=50
UPLOAD_MAX_FILE_SIZE_BYTES=104857600
